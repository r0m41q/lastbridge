# Copy to .env for local use. Compose reads these values from .env automatically.
LASTBRIDGE_HOST=127.0.0.1
LASTBRIDGE_PORT=5274
LASTBRIDGE_LOG_LEVEL=INFO
# Host paths for Docker bind mounts. Configure these in the server's .env.
LASTBRIDGE_DATA_DIR_HOST=./data
LASTBRIDGE_SAVED_AUDIO_DIR_HOST=./data/saved/audio
# Local path; Compose fixes its internal storage path at /app/data.
LASTBRIDGE_DATA_DIR=./data

# Browser origin and Last.fm callback origin; use your external HTTPS origin.
LASTBRIDGE_PUBLIC_URL=http://127.0.0.1:5274
# Optional server application credentials. Set both to enable browser linking.
# Keep real values in the ignored .env file; never commit or share them.
LASTBRIDGE_LASTFM_API_KEY=
LASTBRIDGE_LASTFM_API_SECRET=

# Absolute ceilings for Administrator-managed audio settings (bytes).
LASTBRIDGE_AUDIO_CACHE_BYTES=1000000000
LASTBRIDGE_AUDIO_FILE_MAX_BYTES=67108864
LASTBRIDGE_AUDIO_FREE_RESERVE_BYTES=268435456

# Optional full Jellyfin refresh endpoint and API key. Leave blank to use
# Jellyfin's scheduled/manual scans. Example: http://jellyfin:8096/Library/Refresh
LASTBRIDGE_JELLYFIN_SCAN_URL=
LASTBRIDGE_JELLYFIN_API_KEY=

# Personal mixes: refresh interval after success; pause after inactivity.
LASTBRIDGE_MIX_REFRESH_HOURS=24
LASTBRIDGE_MIX_INACTIVE_DAYS=7
